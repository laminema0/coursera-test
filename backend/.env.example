# Copy to .env (never commit it). Every setting is optional.
PORT=8787
SOURCES_FILE=sources/en.json
# State (SQLite database news.db) lives here. Unset = memory only, lost on restart.
DATA_DIR=./data
# Older versions kept the X snapshot here; it (and data/*.json) is imported into SQLite once, then renamed *.migrated.
DATA_FILE=./data/snapshot.json

# debug | info | warn | error. Logs are JSON lines on stdout.
LOG_LEVEL=info
# Collection cycle: every CYCLE_INTERVAL_SECONDS; a cycle running longer than CYCLE_TIMEOUT_SECONDS skips its optional
# stages (GDELT, X); at twice that the process exits so systemd/docker restarts it.
CYCLE_INTERVAL_SECONDS=60
CYCLE_TIMEOUT_SECONDS=300
SHUTDOWN_TIMEOUT_SECONDS=45
ARTICLE_RETENTION_HOURS=72
# GDELT=off disables worldwide coverage lookups.
GDELT=on

# HTTP
RATE_LIMIT_PER_MINUTE=120
# Comma-separated browser origins allowed via CORS ("*" = any). Empty = CORS off (the iOS app doesn't need it).
CORS_ORIGINS=
# Who may set the client IP via CF-Connecting-IP: loopback (cloudflared on this host), private (docker network), none.
TRUST_PROXY=loopback
# /metrics is always open to the host and private networks; with a token it can also be scraped through the tunnel.
METRICS_TOKEN=

# Optional, paid: X API. Leave empty to run with free sources only.
X_BEARER_TOKEN=
# Hard limit on X API spend per UTC day, in USD (only used when X is enabled).
DAILY_BUDGET_USD=1.00
