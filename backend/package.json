{
  "name": "news-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Collects news from free sources (RSS, official feeds), optionally from X, and serves it to the iOS app.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "check-sources": "node scripts/check-sources.ts",
    "analyze": "node scripts/analyze.ts",
    "eval": "tsc --noEmit -p eval && node eval/run.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
